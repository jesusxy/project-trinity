+	fixture, err := os.ReadFile("../testdata/test.exe")
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "padded.exe")
+	if err := os.WriteFile(path, fixture, 0600); err != nil {
+		t.Fatal(err)
+	}
+	const size = 17 << 20
+	if err := os.Truncate(path, size); err != nil {
+		t.Fatal(err)
